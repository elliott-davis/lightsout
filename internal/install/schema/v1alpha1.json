{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightsout:install:v1alpha1",
  "title": "Lightsout install config, factory/v1alpha1",
  "description": "The install config holds the defaults, baseline, gate registry, people, role profiles and qualifier keys that govern every repository the factory manages. Every object rejects unknown fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "installation",
    "deploymentManifest",
    "policyApprovers",
    "admins",
    "timers",
    "quotas",
    "contractDefaults",
    "baseline",
    "gateRegistry",
    "qualifierKeys",
    "roles"
  ],
  "properties": {
    "apiVersion": {
      "const": "factory/v1alpha1"
    },
    "kind": {
      "const": "Install"
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "forge": {
          "description": "The one forge this install serves.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "forgeHosts": {
          "description": "Extra forge host:port values no role may reach, for a self-hosted forge such as GitHub Enterprise Server. The public GitHub hosts are always refused when the forge is github (SEC-2, SEC-3).",
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostPort"
          }
        }
      },
      "required": [
        "id",
        "forge"
      ]
    },
    "deploymentManifest": {
      "description": "Digest of the WI-29 deployment manifest that pins templates, sandboxes, tools and permissions.",
      "$ref": "#/$defs/digest"
    },
    "policyApprovers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quorum": {
          "description": "Distinct current approvers needed to activate a new install revision. Default 2. Must be at most the member count.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/person"
          }
        }
      },
      "required": [
        "members"
      ],
      "description": "Enterprise IT. Activating an install revision needs quorum distinct approvers."
    },
    "admins": {
      "description": "Emergency admins (SEC-6). A single current admin suffices to halt or resume.",
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "timers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reviewRounds": {
          "description": "Review rounds before escalating to a contract owner (AGT-5). Default 3.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "replans": {
          "description": "Replans before escalating (INT-15). Default 3.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "acceptanceRepairs": {
          "description": "Acceptance repair rounds before blocking (PIP-15). Default 3.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "inverseRetries": {
          "description": "Inverse repair retries (REC-3). Default 3.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "sameGateFailures": {
          "description": "Consecutive failures of the same gate before stopping (COST-4). The PRD gives no number: required.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "noProgressIterations": {
          "description": "Iterations with no newly passing gate before stopping (COST-7). Default 5.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "spendOverEstimateFactor": {
          "description": "Spend past this multiple of the plan estimate stops a change (COST-7). Default 5.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "sameGateFailures"
      ],
      "description": "Caps and breakers. Absent values take the PRD default where the PRD gives one."
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teams": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/teamQuota"
          }
        },
        "defaultTeam": {
          "$ref": "#/$defs/teamLimit"
        },
        "ciRunsPerPRPerHour": {
          "description": "Gate-of-record CI runs per PR per hour, counted per (repo ID, PR number) (COST-3).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "defaultTeam",
        "ciRunsPerPRPerHour"
      ],
      "description": "Concurrency quotas and CI rate limits (COST-2, COST-3). The PRD gives no numbers: required."
    },
    "contractDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "switchStaleDays": {
          "description": "Install default for overrides.switchStaleDays (CON-9).",
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "switchAbandonedDays": {
          "description": "Install default for overrides.switchAbandonedDays (CON-9).",
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        },
        "reviewBudgetLines": {
          "description": "Install default for overrides.reviewBudgetLines (CON-9).",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      },
      "required": [
        "switchStaleDays",
        "switchAbandonedDays",
        "reviewBudgetLines"
      ],
      "description": "Install-wide defaults that contracts override (CON-9). The PRD gives no numbers: required."
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verify": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/installGate"
          }
        },
        "union": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/installGate"
          }
        },
        "reviewers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pr": {
              "$ref": "#/$defs/agentName"
            },
            "security": {
              "$ref": "#/$defs/agentName"
            }
          },
          "required": [
            "pr",
            "security"
          ],
          "description": "The core reviewers (AGD-3). Distinct, and both enabled roles."
        },
        "knownAgents": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/agentName"
          }
        },
        "protected": {
          "description": "Root-anchored patterns agents may never change. Absent means the default: workflows, actions and every CODEOWNERS location. A list given here must cover every CODEOWNERS location.",
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[\\x20-\\x2e\\x30-\\x5a\\x5e-\\x7a\\x7c\\x7e][\\x20-\\x5a\\x5e-\\x7a\\x7c\\x7e]*$"
          }
        }
      },
      "required": [
        "verify",
        "reviewers"
      ],
      "description": "The factory baseline no contract can loosen (CON-5, AGD-3, SEC-4)."
    },
    "gateRegistry": {
      "description": "Every baseline gate and every gate a contract may reference (CON-4).",
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/gateRef"
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expiry": {
          "description": "Maximum age in seconds of a decision, per operation name. Absent means no expiry.",
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 31536000
          }
        },
        "denialAuditTimeoutSeconds": {
          "description": "Seconds allowed to append a denial record. Default 5.",
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "description": "Settings for authorizing human decisions."
    },
    "qualifierKeys": {
      "description": "Ed25519 public keys of the IT-controlled qualification runners (NFR-2).",
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/agentName"
          },
          "key": {
            "description": "Base64 (standard, padded) of the 32-byte public key.",
            "type": "string",
            "pattern": "^[A-Za-z0-9+/]{43}=$"
          }
        },
        "required": [
          "id",
          "key"
        ]
      }
    },
    "roles": {
      "description": "One entry per enabled role, keyed by role name. A role not listed here is not enabled.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-z0-9-]{0,63}$": {
          "$ref": "#/$defs/role"
        }
      }
    }
  },
  "$defs": {
    "name": {
      "description": "Display name for readers. Never used for identity.",
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[\\x20-\\x7e]{1,100}$"
    },
    "badPathShape": {
      "description": "Matches a leading or trailing slash, an empty segment, or a . or .. segment.",
      "pattern": "(^/|/$|//|(^|/)\\.{1,2}(/|$))"
    },
    "producerId": {
      "description": "Trusted CI producer, as kind:id (for example github-app:12345) (CON-4).",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._-]{1,128}$"
    },
    "workflowId": {
      "description": "Workflow identity within the producer: a positive integer or a string (CON-4).",
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]{1,256}$",
          "not": {
            "$ref": "#/$defs/badPathShape"
          }
        }
      ]
    },
    "workflowRevision": {
      "description": "Pinned workflow revision: a full lowercase 40- or 64-hex commit ID (PIP-2).",
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "checkId": {
      "description": "Job or check identity within the registered workflow (CON-4).",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._ :/(),-]{0,127}$",
      "not": {
        "$ref": "#/$defs/badPathShape"
      }
    },
    "digest": {
      "description": "A SHA-256 digest: sha256: and 64 lowercase hex digits.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "agentName": {
      "description": "An agent or role name.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "forge": {
          "description": "The forge, which must be the installation's forge (v1 has one forge per install).",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "id": {
          "description": "The forge's stable ID of the account. Never a login.",
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
        }
      },
      "required": [
        "forge",
        "id"
      ],
      "description": "A person as the forge's stable ID. Logins can be renamed or recycled and are never used."
    },
    "version": {
      "description": "A version string.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "pinnedName": {
      "description": "A model name or revision.",
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,127}$"
    },
    "hostPort": {
      "description": "A literal host:port. No wildcard, no scheme, no path and no IP literal in brackets. The host is a lowercase DNS name or IPv4 address; the port is checked to be 1 to 65535.",
      "type": "string",
      "maxLength": 260,
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*:[0-9]{1,5}$"
    },
    "installGate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": {
          "description": "The factory obligation this gate satisfies (SEC-4). Both secret-scan and dependency-scan must be present on baseline verify gates.",
          "enum": [
            "secret-scan",
            "dependency-scan"
          ]
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "producerId": {
          "$ref": "#/$defs/producerId"
        },
        "workflowId": {
          "$ref": "#/$defs/workflowId"
        },
        "workflowRevision": {
          "$ref": "#/$defs/workflowRevision"
        },
        "checkId": {
          "$ref": "#/$defs/checkId"
        },
        "mandatory": {
          "description": "Must be true: a baseline gate can never be advisory (CON-5).",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "producerId",
        "workflowId",
        "workflowRevision",
        "checkId",
        "mandatory"
      ],
      "description": "A baseline gate: a contract gate plus the purpose it satisfies."
    },
    "gateRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producerId": {
          "$ref": "#/$defs/producerId"
        },
        "workflowId": {
          "$ref": "#/$defs/workflowId"
        },
        "workflowRevision": {
          "$ref": "#/$defs/workflowRevision"
        },
        "checkId": {
          "$ref": "#/$defs/checkId"
        }
      },
      "required": [
        "producerId",
        "workflowId",
        "workflowRevision",
        "checkId"
      ],
      "description": "A registered gate identity at a pinned revision (CON-4)."
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "template": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "digest"
              ],
              "description": "The role definition (AgentTemplate), by digest."
            },
            "runtime": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "description": "A container image pinned by digest: name@sha256:... A tag alone is not accepted (RUN-6).",
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._/:-]{0,200}@sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "image"
              ]
            },
            "harness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/agentName"
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "name",
                "version",
                "digest"
              ]
            },
            "model": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "$ref": "#/$defs/pinnedName"
                },
                "revision": {
                  "$ref": "#/$defs/pinnedName"
                }
              },
              "required": [
                "name",
                "revision"
              ]
            },
            "endpoint": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "digest": {
                  "$ref": "#/$defs/digest"
                }
              },
              "required": [
                "digest"
              ],
              "description": "The canonical endpoint and gateway route config, by digest."
            },
            "tools": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "$ref": "#/$defs/agentName"
                  },
                  "version": {
                    "$ref": "#/$defs/version"
                  },
                  "permissions": {
                    "type": "array",
                    "maxItems": 64,
                    "uniqueItems": true,
                    "items": {
                      "description": "A v1 tool permission. The vocabulary is closed: it has no merge permission and no permission to push to a protected branch (SEC-2, SEC-3).",
                      "enum": [
                        "repo:read",
                        "issues:read",
                        "issues:comment",
                        "pulls:read",
                        "pulls:review",
                        "checks:read",
                        "branch:push-own"
                      ]
                    }
                  }
                },
                "required": [
                  "name",
                  "version",
                  "permissions"
                ]
              }
            }
          },
          "required": [
            "template",
            "runtime",
            "harness",
            "model",
            "endpoint",
            "tools"
          ],
          "description": "The pinned runtime, harness and model profile of the role (RUN-6, AGT-7)."
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hosts": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/hostPort"
              }
            }
          },
          "required": [
            "hosts"
          ],
          "description": "Where the role's sandbox may connect. Deny by default (SEC-1, RUN-4)."
        },
        "gatewayCredentials": {
          "description": "Credentials the gateway injects at egress, each bound to one exact host and operation list. Sandboxes never hold them (RUN-4).",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/agentName"
              },
              "host": {
                "$ref": "#/$defs/hostPort"
              },
              "operations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 260,
                  "pattern": "^(GET|HEAD|POST|PUT|PATCH|DELETE) /[A-Za-z0-9._~!$&'()+,;=:@%/-]*$"
                }
              }
            },
            "required": [
              "name",
              "host",
              "operations"
            ]
          }
        },
        "sandboxSecrets": {
          "description": "Secrets placed inside the sandbox. Must be empty in v1 (RUN-4); the key exists so that a non-empty list is rejected by name.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "qualification": {
          "description": "Digest of the signed qualification record bytes (NFR-2).",
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "profile",
        "egress",
        "qualification"
      ],
      "description": "One enabled role. Every agent role is assumed to read untrusted input in v1, so there is no field to declare otherwise (SEC-1)."
    },
    "teamLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentSessions": {
          "description": "Concurrent agent sessions (COST-2).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ciRuns": {
          "description": "Concurrent gate-of-record CI runs (COST-2).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "agentSessions",
        "ciRuns"
      ]
    },
    "teamQuota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "teamId": {
          "description": "The forge's stable team ID, prefixed with the forge: github:team:9876.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9._:-]{1,160}$"
        },
        "agentSessions": {
          "description": "Concurrent agent sessions (COST-2).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "ciRuns": {
          "description": "Concurrent gate-of-record CI runs (COST-2).",
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": [
        "teamId",
        "agentSessions",
        "ciRuns"
      ]
    }
  }
}
